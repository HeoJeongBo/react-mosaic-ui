{
	"name": "@heojeongbo/react-mosaic-ui",
	"version": "2.5.0",
	"description": "A modern React tiling window manager with FSD architecture, Rollup bundling, and Tailwind CSS v4",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts"
		},
		"./styles.css": "./dist/styles.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "rollup -c --watch",
		"build": "rollup -c",
		"test": "vitest",
		"test:coverage": "vitest --coverage",
		"typecheck": "bun tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check": "bun run lint && bun run typecheck && bun run test --run",
		"release": "release-it",
		"release:minor": "release-it minor",
		"release:major": "release-it major",
		"release:patch": "release-it patch",
		"release:dry": "release-it --dry-run"
	},
	"keywords": [
		"react",
		"mosaic",
		"window-manager",
		"tiling",
		"split-panel",
		"layout",
		"typescript",
		"tailwind",
		"fsd"
	],
	"author": "heojeongbo <heojungbo@gmail.com> (https://github.com/HeoJeongBo)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HeoJeongBo/react-mosaic-ui.git"
	},
	"homepage": "https://github.com/HeoJeongBo/react-mosaic-ui#readme",
	"bugs": {
		"url": "https://github.com/HeoJeongBo/react-mosaic-ui/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"dependencies": {
		"classnames": "^2.5.1",
		"immer": "^10.1.1",
		"react-dnd": "^16.0.1",
		"react-dnd-html5-backend": "^16.0.1",
		"react-dnd-touch-backend": "^16.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@release-it/conventional-changelog": "^10.0.4",
		"@rollup/plugin-commonjs": "^28.0.1",
		"@rollup/plugin-node-resolve": "^15.3.0",
		"@rollup/plugin-terser": "^0.4.4",
		"@rollup/plugin-typescript": "^12.1.1",
		"@tailwindcss/postcss": "^4.1.18",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.1.0",
		"@testing-library/user-event": "^14.5.2",
		"@types/node": "^22.10.2",
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"@vitest/coverage-v8": "^2.1.8",
		"autoprefixer": "^10.4.20",
		"husky": "^9.1.7",
		"jsdom": "^25.0.1",
		"postcss": "^8.4.49",
		"puppeteer-core": "^25.1.0",
		"react": "^18.3.1",
		"react-dnd-test-backend": "^16.0.1",
		"react-dom": "^18.3.1",
		"release-it": "^19.2.2",
		"rollup": "^4.28.1",
		"rollup-plugin-dts": "^6.1.1",
		"rollup-plugin-peer-deps-external": "^2.2.4",
		"rollup-plugin-postcss": "^4.0.2",
		"tailwindcss": "^4.0.0",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vitest": "^2.1.8"
	}
}
